{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "allowJs": true,
    "types": ["node", "./apps/service/node_modules/@cloudflare/workers-types"]
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "apps/service/script/**/*.ts",
    "apps/service/script/**/*.mjs",
    "apps/service/src/__tests__/**/*.ts",
    "apps/client/e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["scripts/**/*.test.mjs", "apps/service/script/**/*.test.mjs"]
}
