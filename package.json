{
  "name": "alien-form",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @alien-form/alien-mdm --filter @alien-form/alien-worker run dev",
    "dev:web": "pnpm --filter @alien-form/alien-mdm run dev",
    "dev:worker": "pnpm --filter @alien-form/alien-worker run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:core": "pnpm --filter @alien-form/core run test",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
