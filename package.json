{
  "name": "alien-form",
  "private": true,
  "type": "module",
  "scripts": {
    "build:new": "pnpm --filter formwork build && pnpm --filter formwork-vite-plugin build && pnpm --filter @alien-form/client build && pnpm --filter @alien-form/service build",
    "typecheck:new": "pnpm --filter formwork --filter formwork-vite-plugin --filter @alien-form/client --filter @alien-form/service typecheck",
    "test:new": "vitest run",
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @alien-form/client run dev",
    "dev:service": "pnpm --filter @alien-form/service run dev",
    "dev:worker": "pnpm --filter @alien-form/service run dev",
    "build": "pnpm build:new",
    "typecheck": "pnpm typecheck:new && tsc --noEmit",
    "test": "pnpm test:new",
    "migrate:data": "tsx scripts/migrate-formwork-data.ts",
    "capabilities:register": "tsx scripts/register-capabilities.ts",
    "worker:dry-run": "pnpm --filter @alien-form/service exec wrangler deploy --config ../../wrangler.json --dry-run",
    "test:e2e": "playwright test",
    "mcp": "node packages/formwork/dist/stdio.js",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "formwork": "workspace:*",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "solid-js": "1.9.17",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
