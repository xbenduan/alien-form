{
  "name": "@alien-form/validate",
  "version": "0.1.0",
  "description": "Zod-based shared schema & API validation for alien-form (frontend + backend)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external @alien-form/core",
    "test": "vitest run"
  },
  "dependencies": {
    "@alien-form/core": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
