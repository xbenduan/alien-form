{
  "name": "@alien-form/engine",
  "version": "0.1.0",
  "description": "Schema-driven page rendering engine for alien-form (compiler / protocol / registry / runtime)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external @alien-form/core --external @alien-form/validate",
    "test": "vitest run"
  },
  "dependencies": {
    "@alien-form/core": "workspace:*",
    "@alien-form/validate": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
