{
  "name": "@alien-form/engine",
  "version": "0.1.0",
  "description": "Schema-driven page rendering engine with alien-signals",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    }
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsup src/index.ts src/react/index.ts --format esm,cjs --dts --external react --external react-dom --external @alien-form/core --external @alien-form/react",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@alien-form/core": "workspace:*",
    "@alien-form/react": "workspace:*",
    "alien-signals": "^3.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
