{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@alien-form/engine": ["./src/index.ts"],
      "@alien-form/engine/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src", "playground"],
  "exclude": ["dist", "node_modules"]
}
