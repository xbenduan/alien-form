{
  "name": "@alien-form/alienbase",
  "version": "0.1.0",
  "description": "Protocol-driven backend runtime for Alien Form",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external @alien-form/protocol",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alien-form/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
