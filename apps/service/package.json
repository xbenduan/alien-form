{
  "name": "@alien-form/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs --service-only",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --include-runtime false --config wrangler.json",
    "db:reset": "pnpm --filter formwork build && tsx script/migrate.ts --local",
    "deploy": "pnpm --filter formwork build && node script/deploy.mjs",
    "deploy:dry-run": "pnpm --filter formwork build && node script/deploy.mjs --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "formwork": "workspace:*",
    "hono": "4.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  }
}
