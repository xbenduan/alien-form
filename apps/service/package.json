{
  "name": "@alien-form/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --include-runtime false --config ../../wrangler.json",
    "migrate:local": "wrangler d1 migrations apply alien-mdm --local --config ../../wrangler.json",
    "deploy": "wrangler deploy --config ../../wrangler.json"
  },
  "dependencies": {
    "formwork": "workspace:*",
    "hono": "4.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  }
}
