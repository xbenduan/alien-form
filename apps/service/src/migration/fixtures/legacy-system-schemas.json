        },
        "form": {
          "component": "DatePicker",
          "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
          "disabled": true,
          "props": {
            "readOnly": true,
            "showTime": true
          }
        }
      },
      {
        "id": "_sys_model_category.updatedAt",
        "key": "updatedAt",
        "type": "string",
        "title": "更新时间",
        "required": true,
        "storage": {
          "type": "integer",
          "system": true
        },
        "form": {
          "component": "DatePicker",
          "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
          "disabled": true,
          "props": {
            "readOnly": true,
            "showTime": true
          }
        }
      }
    ],
    "form": {
      "type": "object",
      "properties": {
        "base": {
          "type": "void",
          "component": "Card",
          "title": "基础信息",
          "props": {
            "gridSpan": 12
          },
          "properties": {
            "code": {
              "$ref": "#/fields/code"
            },
            "name": {
              "$ref": "#/fields/name"
            },
            "order": {
              "$ref": "#/fields/order"
            },
            "aggregate": {
              "$ref": "#/fields/aggregate"
            }
          }
        },
        "system": {
          "type": "void",
          "component": "Card",
          "title": "系统信息",
          "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
          "props": {
            "gridSpan": 12
          },
          "properties": {
            "id": {
              "$ref": "#/fields/id"
            },
            "createdAt": {
              "$ref": "#/fields/createdAt"
            },
            "updatedAt": {
              "$ref": "#/fields/updatedAt"
            }
          }
        }
      }
    },
    "pages": [
      {
        "router": "list",
        "title": "分类标签",
        "permission": "read",
        "type": "void",
        "component": "layout",
        "slots": {
          "content": {
            "filter": {
              "type": "string",
              "component": "filter",
              "props": {
                "schema": {
                  "$ref": "form-schema"
                },
                "filterFields": "{{ $utils.schemaToFilterFields }}"
              }
            },
            "table": {
              "type": "void",
              "component": "table",
              "props": {
                "rowKey": "id",
                "modelCode": "_sys_model_category",
                "schema": {
                  "$ref": "form-schema"
                },
                "columns": "{{ $utils.schemaToColumns }}",
                "filter": "{{ $form.getFieldValue(\"filter\") }}",
                "loadData": "{{ $service(\"records.list\") }}"
              },
              "slots": {
                "toolbar": {
                  "add": {
                    "type": "void",
                    "component": "record-action",
                    "permission": "create",
                    "props": {
                      "mode": "add",
                      "openMode": "page",
                      "children": "新增"
                    }
                  }
                },
                "batchActions": {
                  "batchDelete": {
                    "type": "void",
                    "component": "batch-button",
                    "permission": "delete",
                    "props": {
                      "children": "批量删除",
                      "danger": true,
                      "confirm": "确认删除选中的记录吗？",
                      "successMessage": "记录已删除",
                      "refreshAfterSuccess": true,
                      "onClick": "{{ ($selection) => $service(\"records.batchDelete\")($selection) }}"
                    }
                  }
                },
                "rowActions": {
                  "edit": {
                    "type": "void",
                    "component": "record-action",
                    "permission": "update",
                    "props": {
                      "mode": "edit",
                      "openMode": "page",
                      "children": "编辑"
                    }
                  },
                  "detail": {
                    "type": "void",
                    "component": "record-action",
                    "permission": "read",
                    "props": {
                      "mode": "detail",
                      "openMode": "drawer",
                      "children": "详情"
                    }
                  },
                  "delete": {
                    "type": "void",
                    "component": "row-button",
                    "permission": "delete",
                    "props": {
                      "danger": true,
                      "icon": "delete",
                      "children": "删除",
                      "confirm": "确认删除这条记录？",
                      "confirmDescription": "删除后无法恢复。",
                      "successMessage": "记录已删除",
                      "refreshAfterSuccess": true,
                      "onClick": "{{ ($row) => $service(\"records.delete\")({ model: \"_sys_model_category\", id: $row.id, record: $row }) }}"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "router": "add",
        "title": "新建分类标签",
        "permission": "create",
        "type": "void",
        "component": "record-form",
        "props": {
          "ok": "确认新增",
          "mode": "add",
          "modelCode": "_sys_model_category",
          "schema": {
            "$ref": "form-schema"
          },
          "submit": "{{ $service(\"record.add\") }}"
        }
      },
      {
        "router": "edit",
        "title": "编辑分类标签",
        "permission": "update",
        "type": "void",
        "component": "record-form",
        "props": {
          "ok": "确认修改",
          "mode": "edit",
          "modelCode": "_sys_model_category",
          "recordId": "{{ $query.id }}",
          "schema": {
            "$ref": "form-schema"
          },
          "submit": "{{ $service(\"record.edit\") }}"
        }
      },
      {
        "router": "detail",
        "title": "详情分类标签",
        "permission": "read",
        "type": "void",
        "component": "record-form",
        "props": {
          "mode": "detail",
          "modelCode": "_sys_model_category",
          "recordId": "{{ $query.id }}",
          "schema": {
            "$ref": "form-schema"
          }
        }
      }
    ]
  }
]
