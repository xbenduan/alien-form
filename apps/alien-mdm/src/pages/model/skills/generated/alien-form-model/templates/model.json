{
  "name": "example_model",
  "title": "示例模型",
  "version": 0,
  "group": "other",
  "singularLabel": "示例模型",
  "pluralLabel": "示例模型",
  "defaultPageSize": 20,
  "fields": [
    {
      "id": "example_model.name",
      "key": "name",
      "type": "string",
      "title": "名称",
      "required": true,
      "storage": {
        "type": "text",
        "index": true
      },
      "form": {
        "component": "Input"
      }
    },
    {
      "id": "example_model.id",
      "key": "id",
      "type": "string",
      "title": "ID",
      "required": true,
      "storage": {
        "type": "text",
        "system": true,
        "unique": true,
        "index": true
      },
      "form": {
        "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
        "disabled": true
      }
    },
    {
      "id": "example_model.createdAt",
      "key": "createdAt",
      "type": "string",
      "title": "创建时间",
      "required": true,
      "storage": {
        "type": "integer",
        "system": true
      },
      "form": {
        "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
        "disabled": true,
        "component": "DatePicker",
        "props": {
          "readOnly": true,
          "showTime": true
        }
      }
    },
    {
      "id": "example_model.updatedAt",
      "key": "updatedAt",
      "type": "string",
      "title": "更新时间",
      "required": true,
      "storage": {
        "type": "integer",
        "system": true
      },
      "form": {
        "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
        "disabled": true,
        "component": "DatePicker",
        "props": {
          "readOnly": true,
          "showTime": true
        }
      }
    }
  ],
  "form": {
    "type": "object",
    "properties": {
      "base": {
        "type": "void",
        "title": "基础信息",
        "properties": {
          "name": {
            "$ref": "#/fields/name"
          }
        },
        "component": "Card",
        "props": {
          "gridSpan": 12
        }
      },
      "system": {
        "type": "void",
        "title": "系统信息",
        "properties": {
          "id": {
            "$ref": "#/fields/id"
          },
          "createdAt": {
            "$ref": "#/fields/createdAt"
          },
          "updatedAt": {
            "$ref": "#/fields/updatedAt"
          }
        },
        "display": "{{ mode === 'detail' ? 'visible' : 'none' }}",
        "component": "Card",
        "props": {
          "gridSpan": 12
        }
      }
    }
  },
  "pages": [
    {
      "type": "void",
      "title": "示例模型",
      "component": "layout",
      "slots": {
        "content": {
          "filter": {
            "type": "string",
            "component": "filter",
            "props": {
              "schema": {
                "$ref": "form-schema"
              },
              "filterFields": "{{ $utils.schemaToFilterFields }}"
            }
          },
          "table": {
            "type": "void",
            "component": "table",
            "props": {
              "rowKey": "id",
              "modelCode": "example_model",
              "schema": {
                "$ref": "form-schema"
              },
              "columns": "{{ $utils.schemaToColumns }}",
              "filter": "{{ $form.getFieldValue(\"filter\") }}",
              "loadData": "{{ $service(\"records.list\") }}"
            },
            "slots": {
              "toolbar": {
                "import": {
                  "type": "void",
                  "component": "Button",
                  "props": {
                    "children": "导入",
                    "onClick": "{{ () => $utils.message.info(\"功能未完善\") }}"
                  },
                  "permission": "create"
                },
                "export": {
                  "type": "void",
                  "component": "Button",
                  "props": {
                    "children": "导出",
                    "onClick": "{{ () => $utils.message.info(\"功能未完善\") }}"
                  },
                  "permission": "read"
                },
                "add": {
                  "type": "void",
                  "component": "record-action",
                  "props": {
                    "mode": "add",
                    "openMode": "drawer",
                    "children": "新增"
                  },
                  "permission": "create"
                }
              },
              "batchActions": {
                "batchDelete": {
                  "type": "void",
                  "component": "batch-button",
                  "props": {
                    "children": "批量删除",
                    "danger": true,
                    "confirm": "确认删除选中的记录吗？",
                    "successMessage": "记录已删除",
                    "refreshAfterSuccess": true,
                    "onClick": "{{ ($selection) => $service(\"records.batchDelete\")($selection) }}"
                  },
                  "permission": "delete"
                }
              },
              "rowActions": {
                "edit": {
                  "type": "void",
                  "component": "record-action",
                  "props": {
                    "mode": "edit",
                    "openMode": "drawer",
                    "children": "编辑"
                  },
                  "permission": "update"
                },
                "detail": {
                  "type": "void",
                  "component": "record-action",
                  "props": {
                    "mode": "detail",
                    "openMode": "drawer",
                    "children": "详情"
                  },
                  "permission": "read"
                },
                "deactivate": {
                  "type": "void",
                  "component": "row-button",
                  "props": {
                    "danger": true,
                    "children": "停用",
                    "onClick": "{{ ($row) => $utils.message.info(\"功能未完善\") }}"
                  },
                  "permission": "update"
                },
                "delete": {
                  "type": "void",
                  "component": "row-button",
                  "props": {
                    "danger": true,
                    "icon": "delete",
                    "children": "删除",
                    "confirm": "确认删除这条记录？",
                    "confirmDescription": "删除后无法恢复。",
                    "successMessage": "记录已删除",
                    "refreshAfterSuccess": true,
                    "onClick": "{{ ($row) => $service(\"records.delete\")({ model: \"example_model\", id: $row.id, record: $row }) }}"
                  },
                  "permission": "delete"
                }
              }
            }
          }
        }
      },
      "permission": "read",
      "router": "list"
    },
    {
      "type": "void",
      "title": "新建示例模型",
      "component": "record-form",
      "props": {
        "ok": "确认新增",
        "mode": "add",
        "modelCode": "example_model",
        "schema": {
          "$ref": "form-schema"
        },
        "submit": "{{ $service(\"record.add\") }}"
      },
      "permission": "create",
      "router": "add"
    },
    {
      "type": "void",
      "title": "编辑示例模型",
      "component": "record-form",
      "props": {
        "ok": "确认修改",
        "mode": "edit",
        "modelCode": "example_model",
        "recordId": "{{ $query.id }}",
        "schema": {
          "$ref": "form-schema"
        },
        "submit": "{{ $service(\"record.edit\") }}"
      },
      "permission": "update",
      "router": "edit"
    },
    {
      "type": "void",
      "title": "详情示例模型",
      "component": "record-form",
      "props": {
        "mode": "detail",
        "modelCode": "example_model",
        "recordId": "{{ $query.id }}",
        "schema": {
          "$ref": "form-schema"
        }
      },
      "permission": "read",
      "router": "detail"
    }
  ]
}
