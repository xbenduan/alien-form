{
  "document": {
    "id": "customer-profile",
    "title": "客户档案",
    "data": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "title": "客户名称", "minLength": 1 },
        "status": {
          "type": "string",
          "title": "合作状态",
          "enum": ["合作中", "待跟进", "已停用"],
          "default": "合作中"
        },
        "profile": {
          "type": "object",
          "title": "基本资料",
          "properties": {
            "industry": { "type": "string", "title": "所属行业" },
            "level": {
              "type": "string",
              "title": "客户级别",
              "enum": ["重点客户", "普通客户"]
            },
            "contact": {
              "type": "object",
              "title": "主要联系人",
              "properties": {
                "name": { "type": "string", "title": "联系人姓名" },
                "phone": { "type": "string", "title": "联系电话" },
                "email": { "type": "string", "title": "电子邮箱" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "addresses": {
          "type": "array",
          "title": "联系地址",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "city": { "type": "string", "title": "城市" },
              "street": { "type": "string", "title": "详细地址" },
              "primary": { "type": "boolean", "title": "默认地址", "default": false }
            },
            "additionalProperties": false
          }
        },
        "notes": { "type": "string", "title": "备注" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "fields": {
      "/name": { "order": -30 },
      "/status": { "order": -20 },
      "/profile": { "order": -10, "table": false, "filter": false },
      "/profile/contact/email": { "form": { "props": { "placeholder": "联系人邮箱" } } },
      "/addresses": { "table": false, "filter": false },
      "/notes": { "table": false, "filter": false }
    },
    "pages": {
      "list": {
        "windows": {
          "add": { "openMode": "modal" },
          "edit": { "openMode": "modal" },
          "detail": { "openMode": "page" }
        }
      }
    }
  },
  "backend": {
    "storage": {
      "table": "biz_customer_profile",
      "bindings": [
        {
          "id": "customer-profile:name",
          "path": "/name",
          "column": "name",
          "sqlType": "TEXT",
          "encoding": "scalar"
        },
        {
          "id": "customer-profile:status",
          "path": "/status",
          "column": "status",
          "sqlType": "TEXT",
          "encoding": "scalar"
        },
        {
          "id": "customer-profile:profile",
          "path": "/profile",
          "column": "profile",
          "sqlType": "TEXT",
          "encoding": "json"
        },
        {
          "id": "customer-profile:addresses",
          "path": "/addresses",
          "column": "addresses",
          "sqlType": "TEXT",
          "encoding": "json"
        },
        {
          "id": "customer-profile:notes",
          "path": "/notes",
          "column": "notes",
          "sqlType": "TEXT",
          "encoding": "scalar"
        }
      ]
    },
    "relations": [],
    "permissions": { "grants": [], "privateFields": [] },
    "behavior": { "rules": [], "commands": {}, "events": {} }
  }
}
