{
  "document": {
    "id": "departments",
    "title": "组织架构",
    "data": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "title": "部门名称", "minLength": 1 },
        "parentId": { "type": ["string", "null"], "title": "上级部门 ID", "default": null },
        "manager": { "type": "string", "title": "负责人" },
        "status": {
          "type": "string",
          "title": "状态",
          "enum": ["启用", "停用"],
          "default": "启用"
        },
        "description": { "type": "string", "title": "部门说明" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "fields": {
      "/name": { "order": -30, "form": { "props": { "placeholder": "输入部门名称" } } },
      "/manager": { "order": -20 },
      "/status": { "order": -10 },
      "/parentId": { "table": false, "filter": false },
      "/description": { "table": false, "filter": false }
    },
    "tree": { "parentField": "/parentId", "labelField": "/name" },
    "pages": {
      "tree-list": {
        "windows": {
          "add": { "openMode": "drawer" },
          "edit": { "openMode": "drawer" },
          "detail": { "openMode": "page" }
        }
      }
    }
  },
  "backend": {
    "storage": {
      "table": "biz_departments",
      "bindings": [
        {
          "id": "departments:name",
          "path": "/name",
          "column": "name",
          "sqlType": "TEXT",
          "encoding": "scalar"
        },
        {
          "id": "departments:parentId",
          "path": "/parentId",
          "column": "parent_id",
          "sqlType": "TEXT",
          "encoding": "scalar",
          "index": "index"
        },
        {
          "id": "departments:manager",
          "path": "/manager",
          "column": "manager",
          "sqlType": "TEXT",
          "encoding": "scalar"
        },
        {
          "id": "departments:status",
          "path": "/status",
          "column": "status",
          "sqlType": "TEXT",
          "encoding": "scalar"
        },
        {
          "id": "departments:description",
          "path": "/description",
          "column": "description",
          "sqlType": "TEXT",
          "encoding": "scalar"
        }
      ]
    },
    "relations": [
      {
        "fieldId": "departments:parentId",
        "targetModel": "departments",
        "targetFieldId": "id",
        "kind": "many-to-one"
      }
    ],
    "permissions": { "grants": [], "privateFields": [] },
    "behavior": { "rules": [], "commands": {}, "events": {} }
  }
}
